# Copia este archivo a .env y completa los valores cuando conectes PostgreSQL.

# PostgreSQL (Render u otro proveedor)
# Formato: postgresql://usuario:password@host:puerto/nombre_bd
DATABASE_URL=

# Claves de la aplicación (genera valores seguros en producción)
SECRET_KEY=
JWT_SECRET_KEY=

# Groq (sugerencias de posts)
GROQ_API_KEY=

# Entorno Flask (opcional)
FLASK_ENV=development
